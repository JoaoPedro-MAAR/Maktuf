@startuml arquitetura_componentes_v2
skinparam componentStyle uml2
left to right direction

package "Sensor" {
    usecase "Sensor de\nTemperatura" as TempA
    usecase "Armazenamento\n(buffer offline;\ndescarta a mais antiga)" as StorageA
    usecase "Biblioteca de\ncomunicação" as LibA

    TempA --> StorageA
    StorageA --> LibA
}

package "Broker primário" {
    usecase "Gateway\n(sessão e fila\npor sensor)" as Gateway
    usecase "Monitor de status\n(dormindo/offline)" as Monitor
    usecase "Gerenciador\nde Tópicos" as Gerenciador
    usecase "Armazenamento\npersistente" as StorageBroker
    usecase "Replicação e\nheartbeat\n(aval do Juiz sem reserva)" as Replicacao

    Gateway --> Monitor
    Gateway --> Gerenciador
    Gerenciador --> StorageBroker
    StorageBroker --> Replicacao
}

package "Broker reserva" {
    usecase "Réplica\n(mesmos componentes\ndo primário; papéis\ntrocam no failover)" as Replica
}

package "Endereço virtual (vip)" {
    usecase "Proxy TCP\n(leva ao broker que\naceita o CONNECT)" as Vip
}

package "Juiz" {
    usecase "Monitor de\nheartbeat" as Heartbeat
    usecase "Coordenação de\nfailover e\nsincronização" as Coordenacao

    Heartbeat --> Coordenacao
}

package "Consumidor" {
    usecase "Biblioteca de\ncomunicação" as ClientConsumidor
    usecase "Tratamento de\nduplicatas\n(sensor + seq)" as Tratamento
    usecase "Aplicação" as App

    ClientConsumidor --> Tratamento
    Tratamento --> App
}

LibA --> Vip : TCP: PUBLISH / PUBACK(seq),\nSLEEP
ClientConsumidor --> Vip : TCP: SUBSCRIBE /\nDELIVER / DELIVER_ACK
Vip --> Gateway : repassa ao primário atual
Vip ..> Replica : após o failover\n(reserva promovida)
Replicacao --> Replica : TCP: REPLICA (registros\ndo store) / REPLICA_ACK
Replicacao --> Heartbeat : HEARTBEAT / eco
Replica --> Heartbeat : HEARTBEAT / eco
Coordenacao ..> Replica : PROMOTE (primário sem\nheartbeat e reserva sincronizada)
Coordenacao ..> Replicacao : PROMOTE(outro): antigo\nprimário volta como reserva

@enduml
