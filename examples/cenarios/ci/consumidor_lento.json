{
  "name": "consumidor_lento_ci",
  "description": "Versão reduzida do consumidor lento (RF-36, RF-37, CT-10): o consumidor processa ~6 leituras/s e a fila do assinante estoura a retenção; a lacuna chega sinalizada com GAP_BEFORE. A biblioteca cliente segura até 64 mensagens antes de parar de confirmar.",
  "seed": 4,
  "duration": "12s",
  "scrape_interval": "500ms",
  "drain": "20s",
  "cluster": {
    "replicated": true,
    "judge": true,
    "subscriber_queue": 10
  },
  "sensors": [
    {
      "group": "sensor",
      "count": 5,
      "continuous_ratio": 1,
      "continuous_interval": "100ms",
      "stagger": false
    }
  ],
  "consumers": [
    {
      "client_id": "lento",
      "process_delay": "150ms"
    }
  ],
  "goals": [
    {
      "name": "RF-37 descartes por retencao",
      "type": "metric",
      "process": "brokers",
      "metric": "retention_drops_total",
      "min": 1
    },
    {
      "name": "RF-37 lacuna sinalizada ao consumidor",
      "type": "metric",
      "process": "consumidor:lento",
      "metric": "sequence_gaps_total",
      "labels": {
        "cause": "retention"
      },
      "min": 1
    },
    {
      "name": "Nenhuma lacuna sem marca",
      "type": "metric",
      "process": "consumidor:lento",
      "metric": "missing_readings_total",
      "labels": {
        "cause": "unmarked"
      },
      "max": 0
    }
  ]
}